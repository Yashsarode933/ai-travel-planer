// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

model Trip {
  id            String   @id @default(cuid())
  destination   String
  budgetTier    BudgetTier
  days          Int
  interests     String?
  travelDates   String?
  currency      String
  totalEstimatedCost Float
  shareToken    String? @unique
  isPublic      Boolean @default(false)
  notes         String?  // User's personal notes for this trip
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  places        Place[]
  restaurants   Restaurant[]
  itinerary     Itinerary[]
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String?  // Hashed password (optional for email-only login)
  name          String?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  trips         Trip[]
  favorites     Favorite[]
  activities    UserActivity[]
}

model Place {
  id                     String   @id @default(cuid())
  name                   String
  category               String
  description            String?
  estimatedCost          Float
  estimatedDurationMinutes Int
  tags                   String?
  rating                 Float?
  reviewCount            Int?
  lat                    Float?
  lng                    Float?
  photoRef               String?
  openingHours           String?
  address                String?
  notes                  String?  // User's personal notes for this place
  tripId                 String
  trip                   Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Restaurant {
  id          String   @id @default(cuid())
  name        String
  cuisine     String
  description String?
  priceRange  PriceRange
  mealType    MealType
  rating      Float?
  reviewCount Int?
  lat         Float?
  lng         Float?
  photoRef    String?
  openingHours String?
  address     String?
  notes       String?  // User's personal notes for this restaurant
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Itinerary {
  id              String  @id @default(cuid())
  day             Int
  morningType     String // "place" or "restaurant"
  morningRefId    String
  morningNotes    String?
  afternoonType   String // "place" or "restaurant"
  afternoonRefId  String
  afternoonNotes  String?
  eveningType     String // "place" or "restaurant"
  eveningRefId    String
  eveningNotes    String?
  tripId          String
  trip            Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Favorite {
  id          String   @id @default(cuid())
  type        FavoriteType
  itemId      String   // Place or Restaurant ID
  addedAt     DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, itemId])
}

model UserActivity {
  id          String   @id @default(cuid())
  type        ActivityType
  itemId      String?  // Optional - for specific item references
  itemType    String?  // "trip", "place", "restaurant"
  metadata    String?  // JSON string with additional data
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum FavoriteType {
  PLACE
  RESTAURANT
  TRIP
}

enum ActivityType {
  VIEW
  SAVE
  SHARE
  LIKE
  DISLIKE
}

enum BudgetTier {
  budget
  mid_range
  luxury
}

enum PriceRange {
  ONE
  TWO
  THREE
  FOUR
}

enum MealType {
  breakfast
  lunch
  dinner
}