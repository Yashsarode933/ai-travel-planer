# Database
DATABASE_URL="file:./dev.db"

# AI Services - Groq API (or set OPENAI_API_KEY for OpenAI)
GROQ_API_KEY="your-groq-api-key-here"
# OPENAI_API_KEY="your-openai-api-key"  # Alternative: use OpenAI

# AI Provider Selection (optional)
AI_PROVIDER="groq"

# AI Model Selection
OPENAI_MODEL="llama-3.1-70b-toolcall"

# Google Maps APIs
GOOGLE_MAPS_SERVER_API_KEY="your-google-maps-server-api-key"
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY="your-google-maps-browser-api-key"

# Google OAuth (required for user authentication)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"